# 复制本文件为 .env 并填写本地 MySQL 密码
DB_NAME=campus_second_hand
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_HOST=127.0.0.1
DB_PORT=3306
SECRET_KEY=请生成一串随机密钥

# 本地调试打开；服务器上必须是 False（或不写这一行）
DEBUG=True

# 允许访问的域名/IP，逗号分隔。服务器上改成公网 IP 或域名
ALLOWED_HOSTS=127.0.0.1,localhost

# 用 https://域名 访问时必填（如 https://example.com），否则所有 POST 都会 403
CSRF_TRUSTED_ORIGINS=

# 上了 HTTPS 后改成 True：强制 http 跳 https，并开启 HSTS 与 Secure Cookie
SECURE_SSL=False
